{% set path = path %}

<div class="d-flex justify-content-center mt-4">
    {% if page > 1 %}
        <a href="{{ path(path, {page: page - 1, search: app.request.query.get('search')}) }}" class="btn btn-outline-primary me-2">Précédent</a>
    {% endif %}

    {% if espaces|length >= limit %}
        <a href="{{ path(path, {page: page + 1, search: app.request.query.get('search')}) }}" class="btn btn-outline-primary">Suivant</a>
    {% endif %}
</div>
