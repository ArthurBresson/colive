{% extends 'base.html.twig' %}

{% block title %}CoLive - Connexion{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --colive-blue: #1d3557;
            --colive-light-blue: #f8f8fb;
            --colive-coral: #e76f51;
            --colive-yellow: #e9c46a;
        }

        .login-section {
            background-color: var(--colive-light-blue);
            min-height: 80vh;
            display: flex;
            align-items: center;
        }

        .login-card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .colive-input {
            transition: all 0.3s ease;
            border: 2px solid #eee !important;
            padding: 12px 15px;
        }

        .colive-input:focus {
            border-color: var(--colive-yellow) !important;
            box-shadow: 0 0 0 0.25rem rgba(233, 196, 106, 0.25) !important;
            transform: translateY(-2px);
        }

        .btn-login {
            background-color: var(--colive-coral);
            color: white;
            border: none;
            font-weight: 700;
            padding: 12px;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .btn-login:hover {
            background-color: #d65d41;
            color: white;
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 8px 15px rgba(231, 111, 81, 0.2);
        }

        .text-colive-blue { color: var(--colive-blue); }

        .btn-forgotten {
            background: none;
            border: none;
            color: #6c757d;
            font-size: 0.875rem;
            text-decoration: none;
            transition: color 0.2s;
        }
        .btn-forgotten:hover {
            color: var(--colive-coral);
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block main %}
    <section class="login-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-6 col-lg-4">

                    {# Affichage des messages Flash (Confirmation d'envoi du mail troll) #}
                    {% for message in app.flashes('info') %}
                        <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4 text-center">
                            {{ message }}
                        </div>
                    {% endfor %}

                    <div class="text-center mb-4">
                        <h1 class="h2 fw-bold text-colive-blue">Bon retour !</h1>
                        <p class="text-muted">Connectez-vous pour accéder à vos colocations.</p>
                    </div>

                    <div class="card login-card p-4">
                        {# Ajout de l'ID login-form #}
                        <form method="post" id="login-form">
                            {% if error %}
                                <div class="alert alert-danger py-2 small border-0 mb-4" role="alert">
                                    {{ error.messageKey|trans(error.messageData, 'security') }}
                                </div>
                            {% endif %}

                            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                                <div class="alert alert-info py-2 small border-0 mb-4">
                                    Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                                    <br><a href="{{ logout_path() }}" class="alert-link">Se déconnecter</a>
                                </div>
                            {% endif %}

                            <div class="mb-3">
                                <label for="username" class="form-label fw-bold text-colive-blue small">Email</label>
                                <input type="email" value="{{ last_username }}" name="_username" id="username"
                                       class="form-control colive-input rounded-3"
                                       placeholder="exemple@mail.com"
                                       autocomplete="email" required autofocus>
                            </div>

                            <div class="mb-4">
                                <label for="password" class="form-label fw-bold text-colive-blue small">Mot de passe</label>
                                <input type="password" name="_password" id="password"
                                       class="form-control colive-input rounded-3"
                                       placeholder="••••••••"
                                       autocomplete="current-password" required>
                            </div>

                            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                            <button class="btn btn-login w-100 rounded-3 mb-3" type="submit">
                                Se connecter
                            </button>

                            <div class="text-center mt-3">
                                <p class="small text-muted mb-0">Pas encore de compte ?
                                    <a href="{{ path('app_register') }}" style="color: #e76f51; font-weight: 700; text-decoration: none;">
                                        Créez-en un ici !
                                    </a>
                                </p>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
