{% extends 'base.html.twig' %}

{% block title %}Liste des membres{% endblock %}

{% block main %}
<div class="container mt-4">
    <h2>Membres de Colive</h2>
    <div class="row">
        {% for user in utilisateurs %}
            {% if user != app.user %}
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title mb-0">{{ user.email }}</h5>
                                <small class="text-muted">Membre Colive</small>
                            </div>
                            <a href="{{ path('app_message_start', {id: user.id}) }}" class="btn btn-primary btn-sm">
                                <i class="bi bi-chat-dots"></i> Message
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endblock %}
